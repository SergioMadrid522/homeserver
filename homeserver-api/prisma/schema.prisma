// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum USER_ROLE {
  OWNER
  CLIENT
}

model User {
  userId         Int       @id @default(autoincrement()) @map("user_id")
  name           String
  lastname       String
  email          String    @unique
  passwordHash   String    @map("password_hash")
  role           USER_ROLE @default(CLIENT)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  lastLogin      DateTime? @map("last_login")
  storageLimit   BigInt    @default(150000000000) @map("storage_limit")
  currentStorage BigInt    @default(0) @map("current_storage")
  profilePicture String?   @map("profile_picture")
  deletedAt      DateTime? @map("deleted_at")
  emailVerified  Boolean   @default(false) @map("email_verified")

  files              File[]              @relation("Tiene")
  folders            Folder[]            @relation("Tiene")
  recoverPasswords   RecoverPassword[]
  emailVerifications EmailVerification[]

  @@map("users")
}

model File {
  fileId      Int       @id @default(autoincrement()) @map("file_id")
  name        String
  storageName String    @unique @map("storage_name")
  mimeType    String    @map("mime_type")
  size        BigInt
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  isDeleted   Boolean   @default(false) @map("is_deleted")
  deletedAt   DateTime? @map("deleted_at")
  checksum    String    @db.VarChar(64)
  isFavorite  Boolean   @default(false) @map("is_favorite")

  user   User @relation("Tiene", fields: [userId], references: [userId])
  userId Int  @map("user_id")

  folder   Folder? @relation(fields: [folderId], references: [folderId])
  folderId Int?    @map("folder_id")

  @@map("files")
}

model Folder {
  folderId       Int       @id @default(autoincrement()) @map("folder_id")
  title          String
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  parentFolderId Int?      @map("parent_folder")
  isDeleted      Boolean   @default(false) @map("is_deleted")
  deletedAt      DateTime? @map("deleted_at")
  color          String    @default("#6EA8FE") @db.VarChar(7)
  isFavorite     Boolean   @default(false) @map("is_favorite")

  user   User @relation("Tiene", fields: [userId], references: [userId])
  userId Int  @map("user_id")

  files File[]

  parent Folder? @relation("FolderHierarchy", fields: [parentFolderId], references: [folderId])

  children Folder[] @relation("FolderHierarchy")

  @@map("folders")
}

model RecoverPassword {
  recoverId Int      @id @default(autoincrement()) @map("recover_id")
  codeHash  String   @unique @map("code_hash")
  createdAt DateTime @default(now()) @map("created_at")
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false) @map("is_used")
  expiresAt DateTime @map("expires_at")

  user   User @relation(fields: [userId], references: [userId])
  userId Int  @map("user_id")

  @@map("recover_password")
}

model EmailVerification {
  verificationId Int      @id @default(autoincrement()) @map("verification_id")
  tokenHash      String   @map("token_hash")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")
  isUsed         Boolean  @default(false) @map("is_used")

  user   User @relation(fields: [userId], references: [userId])
  userId Int  @map("user_id")

  @@map("email_verification")
}
